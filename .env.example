# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phardev_dev"

# NextAuth v5 — OAuth providers only (ADR-0002, no Credentials)
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# NextAuth v5 host config (v5 uses AUTH_URL, not NEXTAUTH_URL)
AUTH_URL="http://localhost:3000"
# Set to true in local dev or behind a reverse proxy
AUTH_TRUST_HOST=true

# GitHub OAuth App: https://github.com/settings/developers
# Callback URL to register: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
